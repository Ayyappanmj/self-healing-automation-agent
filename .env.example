# LLM is optional. Leave LLM_PROVIDER=none for deterministic-only healing.
LLM_PROVIDER=none     # none | ollama | gemini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=AQ.your_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Healing safety
CONFIDENCE_THRESHOLD=0.75
MAX_HEALING_ATTEMPTS=2
ACTION_TIMEOUT_MS=3000
ACTION_RETRIES=2
LLM_TIMEOUT_S=30

DB_PATH=data/healing.db
LOG_DIR=data/logs
SCREENSHOT_DIR=screenshots
LOG_LEVEL=INFO
# true = reuse locators healed in earlier runs instead of healing again (off for the demo)
REUSE_HEALED_LOCATORS=false
# Hosted, read-only copy that shows a recorded run instead of launching browsers (see docs/deployment.md)
SHOWCASE_MODE=false
SHOWCASE_FILE=showcase/showcase_run.json
HEADLESS=false
